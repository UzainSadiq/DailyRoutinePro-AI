# GEMINI_API_KEY: Required for Gemini AI API calls.
# Get one from: https://aistudio.google.com/app/apikey (Google AI Studio)
GEMINI_API_KEY=

# OPENWEATHER_API_KEY: Required for live weather updates.
# Get one from: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Environment
NODE_ENV=production
