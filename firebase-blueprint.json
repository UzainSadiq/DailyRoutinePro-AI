{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Stores user preferences and basic profile info.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "theme": { "type": "string", "enum": ["light", "dark"] },
        "sleepGoal": { "type": "number", "description": "Hours of sleep goal" },
        "waterGoal": { "type": "number", "description": "ML of water goal" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email"]
    },
    "Task": {
      "title": "Daily Task",
      "description": "A scheduled task or reminder.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string", "enum": ["Study", "Office", "Exercise", "Sleep", "Food", "Water", "Prayer", "Medication", "Meeting", "Goal"] },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "startTime": { "type": "string", "format": "date-time" },
        "completed": { "type": "boolean" },
        "repeat": { "type": "string", "enum": ["none", "daily", "weekly", "monthly"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "category"]
    },
    "HabitLog": {
      "title": "Habit Log",
      "description": "Daily tracking of habits like water, exercise, etc.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["Water", "Exercise", "Sleep", "Meal", "ScreenTime"] },
        "value": { "type": "number" },
        "unit": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "value", "date"]
    },
    "AISuggestion": {
      "title": "AI Suggestion",
      "description": "Smart suggestions generated by Gemini.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "content": { "type": "string" },
        "type": { "type": "string", "enum": ["Motivation", "Health", "Productivity", "Weather"] },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "content", "type"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "Global tasks collection, usually filtered by userId"
    },
    "/habitLogs/{logId}": {
      "schema": "HabitLog",
      "description": "Logs for various habits"
    },
    "/aiSuggestions/{suggestionId}": {
      "schema": "AISuggestion",
      "description": "Suggestions generated for the user"
    }
  }
}
